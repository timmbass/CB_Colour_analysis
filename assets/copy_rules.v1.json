    },
    "fallback_profile": {
      "tagline_key": "autumn",
      "best_colors": ["Olive", "Teal", "Rust", "Berry"],
      "best_neutrals": ["Taupe", "Soft navy", "Warm grey", "Cream"],
      "metals": ["Gold", "Silver"],
      "avoid": ["Neon extremes", "Very icy contrasts"],
      "style_note": "Use medium contrast outfits and prioritise harmony over extremes."
    }
  }
}
