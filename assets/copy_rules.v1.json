      "best_colors": ["Rose", "Periwinkle", "Slate blue", "Cool raspberry", "Soft plum"],
      "best_neutrals": ["Soft white", "Blue-grey", "Cool taupe", "Soft navy"],
      "metals": ["Silver", "White gold"],
      "avoid": ["Mustard", "Orange-red", "Golden beige"],
      "style_note": "Choose cool, elegant blends and avoid overt warmth."
    },
    "soft_summer": {
      "tagline_key": "soft_summer",
      "best_colors": ["Misty blue", "Mauve", "Soft berry", "Sage", "Muted teal"],
      "best_neutrals": ["Mushroom", "Soft charcoal", "Taupe", "Soft navy"],
      "metals": ["Brushed silver", "Soft white gold"],
      "avoid": ["Neon tones", "Harsh black", "Warm orange"],
      "style_note": "Keep contrast gentle and colours softly diffused."
    },
    "cool_winter": {
      "tagline_key": "cool_winter",
      "best_colors": ["Blue-red", "Royal blue", "Magenta", "Pine green", "Icy lavender"],
      "best_neutrals": ["Black", "White", "Cool charcoal", "Navy"],
      "metals": ["Silver", "White gold", "Platinum"],
      "avoid": ["Camel", "Orange-brown", "Muted olive"],
      "style_note": "Crisp contrast and cool clarity are your strongest levers."
    },
    "bright_winter": {
      "tagline_key": "bright_winter",
      "best_colors": ["Hot pink", "Electric blue", "True red", "Emerald", "Lemon ice"],
      "best_neutrals": ["Black", "True white", "Ink navy", "Cool charcoal"],
      "metals": ["High-shine silver", "White gold"],
      "avoid": ["Dusty tones", "Muted khaki", "Warm cream"],
      "style_note": "Bold clarity and contrast make your features look most vivid."
    },
    "warm_spring": {
      "tagline_key": "warm_spring",
      "best_colors": ["Peach", "Coral", "Leaf green", "Aqua", "Daffodil"],
      "best_neutrals": ["Warm ivory", "Light camel", "Golden beige", "Warm navy"],
      "metals": ["Yellow gold", "Light rose gold"],
      "avoid": ["Dusty rose", "Cool charcoal", "Blue-black"],
      "style_note": "Warm, bright colours keep your complexion lively and clear."
    },
    "neutral_spring": {
      "tagline_key": "neutral_spring",
      "best_colors": ["Salmon", "Apricot", "Turquoise", "Fresh green", "Light warm red"],
      "best_neutrals": ["Ivory", "Warm stone", "Camel", "Soft navy"],
